generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  PROVIDER
  ADMIN
}

enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QueueStatus {
  WAITING
  CALLED
  IN_SERVICE
  COMPLETED
  SKIPPED
  NO_SHOW
  CANCELLED
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  name         String
  phone        String?
  passwordHash String
  role         Role           @default(CUSTOMER)
  providerId   String?
  provider     Provider?      @relation(fields: [providerId], references: [id])
  tokens       RefreshToken[]
  appointments Appointment[]
  notifications Notification[]
  idempotencyKeys IdempotencyKey[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
}

model Provider {
  id             String                 @id @default(uuid())
  name           String
  category       String
  timezone       String                 @default("Asia/Kolkata")
  isActive       Boolean                @default(true)
  users          User[]
  availabilities ProviderAvailability[]
  services       Service[]
  appointments   Appointment[]
  queueEntries   QueueEntry[]
  tokenCounters  TokenCounter[]
}

model ProviderAvailability {
  id         String   @id @default(uuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])
  weekday    Int      // 0-6
  startMin   Int
  endMin     Int

  @@unique([providerId, weekday, startMin])
}

model Service {
  id          String        @id @default(uuid())
  providerId  String
  provider    Provider      @relation(fields: [providerId], references: [id])
  name        String
  durationMin Int
  isActive    Boolean       @default(true)
  appointments Appointment[]
}

model Appointment {
  id         String            @id @default(uuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  providerId String
  provider   Provider          @relation(fields: [providerId], references: [id])
  serviceId  String
  service    Service           @relation(fields: [serviceId], references: [id])
  startsAt   DateTime
  endsAt     DateTime
  status     AppointmentStatus @default(BOOKED)
  priority   Int               @default(0) // 0/1/2
  notes      String?
  queueEntry QueueEntry?
}

model QueueEntry {
  id               String      @id @default(uuid())
  appointmentId    String      @unique
  appointment      Appointment @relation(fields: [appointmentId], references: [id])
  providerId       String
  provider         Provider    @relation(fields: [providerId], references: [id])
  queueDate        DateTime    @db.Date
  tokenNumber      Int
  tokenLabel       String
  status           QueueStatus @default(WAITING)
  priority         Int         @default(0)
  checkedInAt      DateTime    @default(now())
  requeuedAt       DateTime?
  calledAt         DateTime?
  serviceStartedAt DateTime?
  completedAt      DateTime?
  skipCount        Int         @default(0)

  @@unique([providerId, queueDate, tokenNumber])
  @@index([providerId, queueDate, status])
}

model TokenCounter {
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id])
  queueDate   DateTime @db.Date
  lastNumber  Int

  @@id([providerId, queueDate])
}

model OutboxEvent {
  id          String       @id @default(uuid())
  type        String
  aggregateId String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  createdAt   DateTime     @default(now())
  processedAt DateTime?
}

model IdempotencyKey {
  id           String  @id @default(uuid())
  key          String
  userId       String
  user         User    @relation(fields: [userId], references: [id])
  requestHash  String
  responseCode Int?
  responseBody String?

  @@unique([userId, key])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())
}
